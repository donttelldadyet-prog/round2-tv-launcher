    "variables": [
     {
      "name": "now",
      "value": "{{timestamp * 1000}}"
     },
     {
      "name": "act",
      "value": "{{lower(trim(ifempty(1.action; \"\")))}}"
     },
     {
      "name": "staffOk",
      "value": "{{if(1.staff = \"STAFF_CODE\"; \"yes\"; \"no\")}}"
     },
     {
      "name": "room",
      "value": "{{replace(lower(trim(ifempty(1.room; \"\"))); \"maximillion\"; \"max\")}}"
     },
     {
      "name": "roomOk",
      "value": "{{if(contains(split(\"vale,kaeden,scarlett,bella,kai,atlas,max\"; \",\"); replace(lower(trim(ifempty(1.room; \"\"))); \"maximillion\"; \"max\")); \"yes\"; \"no\")}}"
     },
     {
      "name": "start",
      "value": "{{parseNumber(ifempty(1.start; \"0\"); \".\")}}"
     },
     {
      "name": "at",
      "value": "{{parseNumber(ifempty(1.at; \"0\"); \".\")}}"
     },
     {
      "name": "code",
      "value": "{{upper(trim(ifempty(1.code; \"\")))}}"
     }
    ]
   }
